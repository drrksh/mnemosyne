# Mnemosyne configuration. Copy to ~/.mnemosyne/config.env (developer
# machines) or point MNEMOSYNE_CONFIG_FILE at it (servers). Environment
# variables override this file. A .env in the current directory is never
# read. Every setting and its default: src/mnemosyne/config.py

# --- Team mode: use a Mnemosyne server instead of the local database ----
# MNEMOSYNE_SERVER_URL=https://mnemosyne.internal.example.com
# MNEMOSYNE_SERVER_API_KEY=mn_xxxxxxxxxxxx_...

# --- Storage (server, or a local database elsewhere) --------------------
# MNEMOSYNE_DATABASE_URL=postgresql+psycopg://mnemosyne:secret@db:5432/mnemosyne
# MNEMOSYNE_AUTO_MIGRATE=true          # false: run `mnemosyne db upgrade` as a release step

# --- Server --------------------------------------------------------------
# MNEMOSYNE_AUTH_MODE=api_key          # local (single user, loopback only) | api_key
# MNEMOSYNE_API_HOST=0.0.0.0
# MNEMOSYNE_API_PORT=8420
# MNEMOSYNE_RATE_LIMIT_PER_MINUTE=600  # per API key; 0 disables
# MNEMOSYNE_METRICS_PUBLIC=false       # true: /metrics without an admin key
# MNEMOSYNE_CORS_ORIGINS=["https://portal.example.com"]

# --- Context delivered to assistants -------------------------------------
# MNEMOSYNE_CONTEXT_DEFAULT_MAX_TOKENS=1500
# MNEMOSYNE_HOOK_MAX_TOKENS=1800       # Claude Code session-start briefing
# MNEMOSYNE_HOOK_MAX_CHARS=9000        # Claude Code caps injected context at 10,000 characters
# MNEMOSYNE_HOOK_DAEMON=true           # warm background process for fast hooks (Linux, macOS)

# --- Optional: LLM extraction of preferences from session transcripts ---
# Needs `pip install "mnemosyne[llm]"`. Uses ANTHROPIC_API_KEY (or the key below).
# MNEMOSYNE_LLM_EXTRACTION=false
# MNEMOSYNE_LLM_MODEL=claude-opus-5-5
# MNEMOSYNE_ANTHROPIC_API_KEY=

# --- Optional: neural embeddings instead of the built-in hashing embedder -
# MNEMOSYNE_EMBEDDER=hashing           # hashing | http | sentence-transformers
# MNEMOSYNE_EMBEDDING_HTTP_URL=https://api.openai.com/v1/embeddings
# MNEMOSYNE_EMBEDDING_HTTP_MODEL=text-embedding-3-small
# MNEMOSYNE_EMBEDDING_HTTP_API_KEY=

# --- Learning thresholds --------------------------------------------------
# MNEMOSYNE_LEARNING_MIN_CONFIDENCE=0.55
# MNEMOSYNE_GENERALIZE_MIN_REPOS=2
